<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingshu.mapper.UserPracticeHistoryMapper">
    
    <!-- 根据用户ID查询刷题记录 -->
    <select id="selectByUserId" resultType="com.lingshu.entity.UserPracticeHistory">
        SELECT * FROM user_practice_history 
        WHERE user_id = #{userId} 
        ORDER BY created_at DESC
    </select>
    
    <!-- 根据用户ID和题目ID查询记录 -->
    <select id="selectByUserIdAndQuestionId" resultType="com.lingshu.entity.UserPracticeHistory">
        SELECT * FROM user_practice_history 
        WHERE user_id = #{userId} 
        AND question_id = #{questionId}
    </select>
    
    <!-- 统计用户已完成的题目数量 -->
    <select id="countCompletedByUserId" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM user_practice_history 
        WHERE user_id = #{userId} 
        AND completed = true
    </select>
    
</mapper>
